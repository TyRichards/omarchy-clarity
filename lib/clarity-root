def configured_urls(plural_name: str, legacy_name: str, defaults: list[str]) -> list[str]:
    raw = os.environ.get(plural_name)
    if raw is None and legacy_name:
        raw = os.environ.get(legacy_name)
    if raw is None:
        return defaults
    return [value.strip() for value in raw.split(",") if value.strip()]


