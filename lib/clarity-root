        fail("this command must run as root")


def atomic_write(path: Path, content: str, mode: int = 0o644) -> None:
    path.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{path.name}.", dir=path.parent)
    tmp = Path(tmp_name)
    try:
        with os.fdopen(fd, "w", encoding="utf-8", newline="\n") as handle:
            handle.write(content)
            handle.flush()
            os.fsync(handle.fileno())
        os.chmod(tmp, mode)
        os.replace(tmp, path)
    finally:
        tmp.unlink(missing_ok=True)


def write_json(path: Path, value: dict, mode: int = 0o644) -> None:
    atomic_write(path, json.dumps(value, indent=2, sort_keys=True) + "\n", mode)


def read_json(path: Path, default: dict | None = None) -> dict:
    if not path.exists():
        if default is not None:
            return default.copy()
        fail(f"Clarity is not installed ({path} is missing)")
    try:
        value = json.loads(path.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        fail(f"cannot read {path}: {error}")
    if not isinstance(value, dict):
        fail(f"invalid Clarity state in {path}")
    return value


def system_backup_targets() -> list[Path]:
    return [
        HOSTS_FILE,
        SUDOERS_FILE,
        *(SYSTEMD_DIR / name for name in SYSTEMD_NAMES),
        ROOT_HELPER,
    ]


def capture_system_backups(legacy_install: bool = False) -> None:
    if BACKUP_MANIFEST.exists():
        return
    BACKUP_DIR.mkdir(parents=True, exist_ok=True)
    entries: dict[str, dict] = {}
    for index, target in enumerate(system_backup_targets()):
        target_key = str(target)
        if legacy_install and target != HOSTS_FILE:
            entries[target_key] = {"existed": False}
            continue

        source = target
        if target == HOSTS_FILE and BACKUP_FILE.exists():
            source = BACKUP_FILE
        if not source.exists():
            entries[target_key] = {"existed": False}
            continue
        if not source.is_file():
            fail(f"cannot back up non-file system path: {target}")

        backup = BACKUP_FILE if target == HOSTS_FILE else BACKUP_DIR / f"{index:02d}-{target.name}"
        if source != backup:
            shutil.copy2(source, backup)
        source_stat = source.stat()
        entries[target_key] = {
            "existed": True,
            "backup": str(backup),
            "mode": stat.S_IMODE(source_stat.st_mode),
            "uid": source_stat.st_uid,
            "gid": source_stat.st_gid,
        }
    write_json(BACKUP_MANIFEST, {"version": 1, "files": entries}, 0o600)


def normalize_domain(raw: str, strict: bool = True) -> str | None:
    value = raw.strip().lower().rstrip(".")
    if not value or value.startswith("#"):
        return None
    if "://" in value:
        value = value.split("://", 1)[1].split("/", 1)[0]
    value = value.split("#", 1)[0].strip()
    if value.startswith("*."):
        value = value[2:]
    if ":" in value:
        value = value.rsplit(":", 1)[0]
    try:
        value = value.encode("idna").decode("ascii")
    except UnicodeError:
        if strict:
            fail(f"invalid domain: {raw.strip()}")
        return None
    if not DOMAIN_RE.fullmatch(value):
        if strict:
            fail(f"invalid domain: {raw.strip()}")
        return None
    return value


def parse_domain_lines(
    text: str, hosts_format: bool = False, max_domains: int | None = None
) -> list[str]:
    domains: set[str] = set()
    for raw_line in io.StringIO(text):
        line = raw_line.split("#", 1)[0].strip()
        if not line:
            continue
        tokens = line.split()
        candidates = tokens
        if hosts_format and tokens and (
            tokens[0] in {"0", "0.0.0.0", "127.0.0.1", "::", "::1"}
            or re.fullmatch(r"[0-9a-f:.]+", tokens[0], re.IGNORECASE)
        ):
            candidates = tokens[1:]
        for candidate in candidates:
            if candidate.lower().rstrip(".") in {"localhost", "localhost.localdomain", "broadcasthost"}:
                continue
            domain = normalize_domain(candidate, strict=not hosts_format)
            if domain and domain not in domains:
                if max_domains is not None and len(domains) >= max_domains:
                    fail(f"domain list exceeds the {max_domains:,}-domain safety limit")
                domains.add(domain)
    return sorted(domains)


def read_domains(path: Path) -> list[str]:
    if not path.exists():
        return []
    return parse_domain_lines(path.read_text(encoding="utf-8"))


def is_allowlisted(domain: str, allowlist: list[str]) -> bool:
    return any(domain == allowed or domain.endswith("." + allowed) for allowed in allowlist)


def without_allowlisted(domains: list[str], allowlist: list[str]) -> list[str]:
    return sorted(domain for domain in domains if not is_allowlisted(domain, allowlist))


def expanded_distraction_domains(domains: list[str]) -> list[str]:
    expanded: set[str] = set()
    for domain in domains:
        expanded.add(domain)
        if not domain.startswith("www."):
            expanded.add(f"www.{domain}")
        if not domain.startswith("m."):
            expanded.add(f"m.{domain}")
    return sorted(expanded)


def effective_distraction_domains() -> list[str]:
    allowlist = sorted(
        set(read_domains(ALLOWLIST_FILE))
        | set(read_domains(FOCUS_ALLOWLIST_FILE))
        | set(read_domains(USER_ALLOWLIST_FILE))
    )
    feed = without_allowlisted(read_domains(DISTRACTION_FEED_FILE), allowlist)
    curated = without_allowlisted(read_domains(SITES_FILE), allowlist)
    return sorted(set(feed) | set(expanded_distraction_domains(curated)))


def strip_managed_sections(text: str) -> str:
    output: list[str] = []
    expected_end: str | None = None
    for line in text.splitlines():
        if expected_end is not None:
            if line == expected_end:
                expected_end = None
            continue
        if line in ALL_MARKERS:
            expected_end = ALL_MARKERS[line]
            continue
        output.append(line)
    if expected_end is not None:
        fail(f"refusing to rewrite {HOSTS_FILE}: unterminated Clarity section")
    while output and output[-1] == "":
        output.pop()
    return "\n".join(output)


def render_section(begin: str, end: str, domains: list[str]) -> str:
    # /etc/hosts supports aliases after an address. Grouping eight domains per
    # row keeps million-domain lists much smaller without changing resolution.
    lines = [begin]
    group_size = 8
    for index in range(0, len(domains), group_size):
        lines.append("0.0.0.0 " + " ".join(domains[index : index + group_size]))
    lines.append(end)
    return "\n".join(lines)


def parse_time(value: str) -> tuple[int, int]:
    if not TIME_RE.fullmatch(value):
        fail(f"invalid time '{value}'; expected HH:MM")
    hour, minute = value.split(":")
    return int(hour), int(minute)


def schedule_windows(config: dict) -> list[dict[str, str]]:
    raw_windows = config.get("scheduleWindows")
    if isinstance(raw_windows, list):
        windows: list[dict[str, str]] = []
        for raw in raw_windows:
            if not isinstance(raw, dict):
                fail("invalid schedule window")
            start = str(raw.get("start", ""))
            end = str(raw.get("end", ""))
            parse_time(start)
            parse_time(end)
            windows.append({"start": start, "end": end})
        return windows
    start = str(config.get("scheduleStart", "09:00"))
    end = str(config.get("scheduleEnd", "17:00"))
    parse_time(start)
    parse_time(end)
    return [{"start": start, "end": end}]


def window_intervals(start_value: str, end_value: str) -> list[tuple[int, int]]:
    start_hour, start_minute = parse_time(start_value)
    end_hour, end_minute = parse_time(end_value)
    start = start_hour * 60 + start_minute
    end = end_hour * 60 + end_minute
    if start == end:
        return [(0, 24 * 60)]
    if start < end:
        return [(start, end)]
    return [(start, 24 * 60), (0, end)]


def windows_overlap(first: dict[str, str], second: dict[str, str]) -> bool:
    return any(
        max(first_start, second_start) < min(first_end, second_end)
        for first_start, first_end in window_intervals(first["start"], first["end"])
        for second_start, second_end in window_intervals(second["start"], second["end"])
    )


def inside_window(start_value: str, end_value: str, current_minutes: int) -> bool:
    return any(start <= current_minutes < end for start, end in window_intervals(start_value, end_value))


def inside_schedule(config: dict, now: dt.datetime | None = None) -> bool:
    current = now or dt.datetime.now().astimezone()
    current_minutes = current.hour * 60 + current.minute
    return any(
        inside_window(window["start"], window["end"], current_minutes)
        for window in schedule_windows(config)
    )


def parse_timestamp(value: str) -> dt.datetime | None:
    try:
        parsed = dt.datetime.fromisoformat(value.replace("Z", "+00:00"))
    except ValueError:
        return None
    if parsed.tzinfo is None:
        return parsed.astimezone()
    return parsed


def current_time(now: dt.datetime | None = None) -> dt.datetime:
    current = now or dt.datetime.now().astimezone()
    if current.tzinfo is None:
        return current.astimezone()
    return current


def schedule_override(config: dict, now: dt.datetime | None = None) -> bool | None:
    if not bool(config.get("scheduleEnabled", False)):
        return None
    until = parse_timestamp(str(config.get("scheduleOverrideUntil", "")))
    if until is None:
        return None
    if until <= current_time(now):
        return None
    return bool(config.get("scheduleOverrideActive", False))


def effective_active(config: dict, now: dt.datetime | None = None) -> bool:
    override = schedule_override(config, now)
    if override is not None:
        return override
    if bool(config.get("scheduleEnabled", False)):
        return inside_schedule(config, now)
    return bool(config.get("manualEnabled", True))


def apply_hosts() -> bool:
    config = read_json(CONFIG_FILE)
    adult_enabled = bool(config.get("adultBlockingEnabled", True))
    allowlist = read_domains(ALLOWLIST_FILE)
    adult_domains = without_allowlisted(read_domains(ADULT_FILE), allowlist) if adult_enabled else []
    if adult_enabled and len(adult_domains) < MIN_ADULT_DOMAINS:
        fail("permanent adult blocklist is missing or unexpectedly small")
    distraction_domains = effective_distraction_domains()
    if len(distraction_domains) < MIN_DISTRACTION_DOMAINS:
        fail("focus blocklist is missing or unexpectedly small")
    original = HOSTS_FILE.read_text(encoding="utf-8") if HOSTS_FILE.exists() else ""
    base = strip_managed_sections(original)
    parts = [base] if base else []
    if adult_enabled:
        parts.append(render_section(PERMANENT_BEGIN, PERMANENT_END, adult_domains))
    if effective_active(config):
        parts.append(render_section(DISTRACTIONS_BEGIN, DISTRACTIONS_END, distraction_domains))
    content = "\n\n".join(parts) + "\n"
    if content == original:
        return False

    previous_stat = HOSTS_FILE.stat() if HOSTS_FILE.exists() else None
    atomic_write(HOSTS_FILE, content, stat.S_IMODE(previous_stat.st_mode) if previous_stat else 0o644)
    if previous_stat and not TEST_ROOT:
        os.chown(HOSTS_FILE, previous_stat.st_uid, previous_stat.st_gid)
    flush_dns()
    return True


def flush_dns() -> None:
    if TEST_ROOT:
        return
    subprocess.run(["resolvectl", "flush-caches"], check=False, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)


def password_record(password: str) -> dict:
    if len(password) < 10:
        fail("Clarity password must be at least 10 characters")
    salt = os.urandom(16)
    digest = hashlib.scrypt(
        password.encode("utf-8"), salt=salt, n=2**15, r=8, p=1, dklen=32, maxmem=64 * 1024 * 1024
    )
    return {
        "algorithm": "scrypt",
        "n": 2**15,
        "r": 8,
        "p": 1,
        "salt": base64.b64encode(salt).decode("ascii"),
        "digest": base64.b64encode(digest).decode("ascii"),
    }


def verify_password(password: str) -> None:
    record = read_json(PASSWORD_FILE)
    try:
        salt = base64.b64decode(record["salt"], validate=True)
        expected = base64.b64decode(record["digest"], validate=True)
        actual = hashlib.scrypt(
            password.encode("utf-8"),
            salt=salt,
            n=int(record["n"]),
            r=int(record["r"]),
            p=int(record["p"]),
            dklen=len(expected),
            maxmem=64 * 1024 * 1024,
        )
    except (KeyError, TypeError, ValueError) as error:
        fail(f"invalid password record: {error}")
    if not hmac.compare_digest(actual, expected):
        fail("incorrect Clarity password")


def read_password_from_stdin() -> str:
    password = sys.stdin.readline(MAX_PASSWORD_CHARS + 1)
    if password == "":
        fail("Clarity password was not provided")
    if len(password) > MAX_PASSWORD_CHARS:
        fail("Clarity password input is too large")
    return password.rstrip("\r\n")


def read_whitelist_from_stdin() -> str:
    content = sys.stdin.read(MAX_WHITELIST_CHARS + 1)
    if len(content) > MAX_WHITELIST_CHARS:
        fail("focus whitelist input exceeds the 1 MiB safety limit")
    return content


def focus_category_for_url(url: str) -> str:
    lowered = url.lower()
    for needle, category in (
        ("youtube", "Video & Streaming"),
        ("amazon", "Shopping"),
        ("gambling", "Gambling"),
        ("torrent", "Torrents"),
        ("facebook", "Social & Feeds"),
        ("tiktok", "Social & Feeds"),
        ("twitter", "Social & Feeds"),
        ("whatsapp", "Social & Feeds"),
        ("social", "Social & Feeds"),
    ):
        if needle in lowered:
            return category
    return "Social & Feeds"


def read_capped_response(response) -> str:
    content_length = response.headers.get("Content-Length")
    if content_length:
        try:
            announced_size = int(content_length)
        except ValueError:
            announced_size = None
        if announced_size is not None and announced_size > MAX_SOURCE_BYTES:
            raise ValueError(
                f"response exceeds the {MAX_SOURCE_BYTES:,}-byte safety limit "
                f"(announced {announced_size:,} bytes)"
            )
    payload = response.read(MAX_SOURCE_BYTES + 1)
    if len(payload) > MAX_SOURCE_BYTES:
        raise ValueError(f"response exceeds the {MAX_SOURCE_BYTES:,}-byte safety limit")
    try:
        return payload.decode("utf-8")
    except UnicodeDecodeError as error:
        raise ValueError(f"response is not valid UTF-8: {error}") from error


def download_sources(urls: list[str], label: str) -> tuple[list[str], list[str], dict[str, list[str]]]:
    merged: set[str] = set()
    successful: list[str] = []
    source_domains: dict[str, list[str]] = {}
    errors: list[str] = []
    for url in urls:
        request = urllib.request.Request(url, headers={"User-Agent": "omarchy-clarity/0.3.2"})
        try:
            with urllib.request.urlopen(request, timeout=90) as response:
                payload = read_capped_response(response)
            domains = parse_domain_lines(
                payload, hosts_format=True, max_domains=MAX_SOURCE_DOMAINS
            )
            if not domains:
                raise ValueError("source contained no valid domains")
            merged_count = len(merged)
            for domain in domains:
                if domain not in merged:
                    merged_count += 1
                    if merged_count > MAX_MERGED_DOMAINS:
                        raise ValueError(
                            f"merged {label} list exceeds the {MAX_MERGED_DOMAINS:,}-domain safety limit"
                        )
            merged.update(domains)
            successful.append(url)
            source_domains[url] = domains
        except Exception as error:
            errors.append(f"{url}: {error}")
    if errors:
        print(f"clarity: warning: {label} source failures:\n  " + "\n  ".join(errors), file=sys.stderr)
    if not successful:
        fail(f"could not download any {label} blocklist source")
    return sorted(merged), successful, source_domains


def block_category_counts(adult_domains: list[str], focus_sources: dict[str, list[str]], focus_exclusions: list[str]) -> dict[str, int]:
    grouped: dict[str, set[str]] = {category: set() for category in BLOCK_CATEGORY_ORDER}
    grouped["Adult"].update(adult_domains)
    for url, domains in focus_sources.items():
        grouped[focus_category_for_url(url)].update(without_allowlisted(domains, focus_exclusions))
    return {category: len(grouped[category]) for category in BLOCK_CATEGORY_ORDER}


def update_lists(apply: bool = True) -> tuple[int, int]:
    config = read_json(CONFIG_FILE, {})
    adult_enabled = bool(config.get("adultBlockingEnabled", True))
    if adult_enabled:
        adult_domains, adult_sources, _adult_source_domains = download_sources(ADULT_URLS, "adult")
    else:
        adult_domains, adult_sources = [], []
    distraction_domains, distraction_sources, focus_source_domains = download_sources(DISTRACTION_URLS, "focus")
    allowlist = read_domains(ALLOWLIST_FILE)
    adult_domains = without_allowlisted(adult_domains, allowlist)
    distraction_domains = without_allowlisted(distraction_domains, allowlist)
    if adult_enabled and len(adult_domains) < MIN_ADULT_DOMAINS:
        fail(f"downloaded adult blocklists contained only {len(adult_domains)} unique domains")
    if len(distraction_domains) < MIN_DISTRACTION_DOMAINS:
        fail(f"downloaded focus blocklists contained only {len(distraction_domains)} unique domains")

    atomic_write(ADULT_FILE, ("\n".join(adult_domains) + "\n") if adult_domains else "", 0o644)
    atomic_write(DISTRACTION_FEED_FILE, "\n".join(distraction_domains) + "\n", 0o644)
    updated = dt.datetime.now(dt.timezone.utc).replace(microsecond=0).isoformat()
    config["adultUpdated"] = updated
    config["listsUpdated"] = updated
    config["adultSources"] = adult_sources
    config["distractionSources"] = distraction_sources
    config["adultCount"] = len(adult_domains)
    config["focusFeedCount"] = len(distraction_domains)
    focus_exclusions = sorted(set(allowlist) | set(read_domains(FOCUS_ALLOWLIST_FILE)))
    config["categoryCounts"] = block_category_counts(adult_domains, focus_source_domains, focus_exclusions)
    config["distractionCount"] = len(effective_distraction_domains())
    config["curatedCount"] = len(read_domains(SITES_FILE))
    config["aiAllowCount"] = len(read_domains(ALLOWLIST_FILE))
    config["focusAllowCount"] = len(read_domains(FOCUS_ALLOWLIST_FILE))
    config["whitelistCount"] = len(read_domains(USER_ALLOWLIST_FILE))
    write_json(CONFIG_FILE, config)
    if apply and PASSWORD_FILE.exists():
        apply_hosts()
    return len(adult_domains), len(distraction_domains)


def update_adult_list(apply: bool = True) -> int:
    # Backward-compatible alias for v0.1 callers.
    return update_lists(apply)[0]


def enable_permanent_adult_blocking() -> int:
    config = read_json(CONFIG_FILE)
    if bool(config.get("adultBlockingEnabled", True)):
        return cached_count(config, "adultCount", lambda: len(read_domains(ADULT_FILE)))

    config["adultBlockingEnabled"] = True
    write_json(CONFIG_FILE, config)
    try:
        adult_count, _focus_count = update_lists()
        return adult_count
    except Exception:
        rollback = read_json(CONFIG_FILE, config)
        rollback["adultBlockingEnabled"] = False
        rollback["adultCount"] = 0
        category_counts = rollback.get("categoryCounts")
        if isinstance(category_counts, dict):
            category_counts["Adult"] = 0
        write_json(CONFIG_FILE, rollback)
        atomic_write(ADULT_FILE, "")
        apply_hosts()
        raise


def run_systemctl(*args: str, check: bool = True) -> None:
    if TEST_ROOT:
        return
    subprocess.run(["systemctl", *args], check=check)


def sudoers_policy(owner: str) -> str:
    if not USER_RE.fullmatch(owner):
        fail(f"unsafe account name '{owner}'")
    rules = "\n".join(
        f"{owner} ALL=(root) NOPASSWD: {PRIVILEGED_HELPER} {arguments}"
        for arguments in RUNTIME_SUDO_ARGUMENTS
    )
    return "# Managed by Clarity; lifecycle commands require administrator authorization\n" + rules + "\n"


def install_system_files(plugin_dir: Path, owner: str) -> None:
    source_helper = plugin_dir / "lib" / "clarity-root"
    source_systemd = plugin_dir / "systemd"
    if not source_helper.is_file() or not source_systemd.is_dir():
        fail("plugin installation files are incomplete")

    ROOT_HELPER.parent.mkdir(parents=True, exist_ok=True)
    shutil.copyfile(source_helper, ROOT_HELPER)
    os.chmod(ROOT_HELPER, 0o755)

    SYSTEMD_DIR.mkdir(parents=True, exist_ok=True)
    for name in SYSTEMD_NAMES:
        shutil.copyfile(source_systemd / name, SYSTEMD_DIR / name)
        os.chmod(SYSTEMD_DIR / name, 0o644)

    atomic_write(SUDOERS_FILE, sudoers_policy(owner), 0o440)
    if not TEST_ROOT:
        result = subprocess.run(["visudo", "-cf", str(SUDOERS_FILE)], capture_output=True, text=True)
        if result.returncode != 0:
            SUDOERS_FILE.unlink(missing_ok=True)
            fail(f"generated sudoers policy is invalid: {result.stderr.strip()}")


def sync_bundled_lists(plugin_dir: Path, merge_sites: bool) -> None:
    defaults = plugin_dir / "config" / "distractions.txt"
    ai_allowlist = plugin_dir / "config" / "ai-allowlist.txt"
    focus_allowlist = plugin_dir / "config" / "focus-allowlist.txt"
    if not defaults.is_file() or not ai_allowlist.is_file() or not focus_allowlist.is_file():
        fail("plugin blocklist configuration is incomplete")
    default_domains = parse_domain_lines(defaults.read_text(encoding="utf-8"))
    if merge_sites:
        default_domains = sorted(set(default_domains) | set(read_domains(SITES_FILE)))
    allow_domains = parse_domain_lines(ai_allowlist.read_text(encoding="utf-8"))
    focus_allow_domains = parse_domain_lines(focus_allowlist.read_text(encoding="utf-8"))
    atomic_write(SITES_FILE, "\n".join(default_domains) + "\n", 0o644)
    atomic_write(ALLOWLIST_FILE, "\n".join(allow_domains) + "\n", 0o644)
    atomic_write(FOCUS_ALLOWLIST_FILE, "\n".join(focus_allow_domains) + "\n", 0o644)
    if not USER_ALLOWLIST_FILE.exists():
        atomic_write(USER_ALLOWLIST_FILE, "", 0o644)


def bootstrap(plugin_dir_arg: str, owner: str, adult_state: str) -> None:
    if PASSWORD_FILE.exists() or SUDOERS_FILE.exists():
        fail("Clarity is already installed; rerun install.sh to upgrade it")
    if adult_state not in {"enabled", "disabled"}:
        fail("permanent adult blocking must be enabled or disabled during setup")
    plugin_dir = Path(plugin_dir_arg).resolve()
    password = read_password_from_stdin()
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    capture_system_backups()

    config = {
        "manualEnabled": True,
        "scheduleEnabled": False,
        "scheduleStart": "09:00",
        "scheduleEnd": "17:00",
        "scheduleWindows": [],
        "scheduleConfigured": False,
        "adultBlockingEnabled": adult_state == "enabled",
        "adultUpdated": "",
        "listsUpdated": "",
        "owner": owner,
    }
    write_json(CONFIG_FILE, config)
    write_json(PASSWORD_FILE, password_record(password), 0o600)
    sync_bundled_lists(plugin_dir, merge_sites=False)

    adult_count, focus_feed_count = update_lists(apply=False)
    install_system_files(plugin_dir, owner)
    apply_hosts()
    run_systemctl("daemon-reload")
    run_systemctl("enable", "--now", "clarity-reconcile.timer", "clarity-adult-list.timer")
    permanent_summary = (
        f"permanently blocking {adult_count} adult domains"
        if adult_state == "enabled"
        else "permanent adult blocking was skipped"
    )
    print(f"Clarity installed: {permanent_summary}; focus feeds contain {focus_feed_count} domains.")


def upgrade(plugin_dir_arg: str) -> None:
    if not PASSWORD_FILE.exists():
        fail("Clarity is not installed")
    plugin_dir = Path(plugin_dir_arg).resolve()
    config = read_json(CONFIG_FILE)
    owner = str(config.get("owner", ""))
    capture_system_backups(legacy_install=True)
    config_changed = False
    if "scheduleWindows" not in config:
        config["scheduleWindows"] = schedule_windows(config)
        config_changed = True
    if "scheduleConfigured" not in config:
        windows = schedule_windows(config)
        if windows == [{"start": "09:00", "end": "17:00"}]:
            config["scheduleWindows"] = []
            config["scheduleEnabled"] = False
            windows = []
        config["scheduleConfigured"] = bool(windows)
        config_changed = True
    if config_changed:
        write_json(CONFIG_FILE, config)
    sync_bundled_lists(plugin_dir, merge_sites=True)
    adult_count, focus_feed_count = update_lists(apply=False)
    install_system_files(plugin_dir, owner)
    apply_hosts()
    run_systemctl("daemon-reload")
    run_systemctl("enable", "--now", "clarity-reconcile.timer", "clarity-adult-list.timer")
    permanent_summary = (
        f"permanently blocking {adult_count} adult domains"
        if bool(config.get("adultBlockingEnabled", True))
        else "permanent adult blocking remains skipped"
    )
    print(f"Clarity upgraded: {permanent_summary}; focus feeds contain {focus_feed_count} domains.")


def cached_count(config: dict, key: str, fallback) -> int:
    value = config.get(key)
    if isinstance(value, int) and not isinstance(value, bool) and value >= 0:
        return value
    return int(fallback())


def status() -> dict:
    config = read_json(CONFIG_FILE)
    active = effective_active(config)
    category_counts = config.get("categoryCounts")
    if not isinstance(category_counts, dict):
        category_counts = {category: 0 for category in BLOCK_CATEGORY_ORDER}
        category_counts["Adult"] = cached_count(
            config,
            "adultCount",
            lambda: len(without_allowlisted(read_domains(ADULT_FILE), read_domains(ALLOWLIST_FILE))),
        )
    override = schedule_override(config)
    if override is not None:
        reason = "Manual override enabled" if active else "Manual override disabled"
    elif bool(config.get("scheduleEnabled", False)):
        reason = "Inside focus window" if active else "Outside focus window"
    else:
        reason = "Manual focus enabled" if active else "Manual focus disabled"
    return {
        "installed": True,
        "backupsReady": BACKUP_MANIFEST.is_file(),
        "active": active,
        "manualEnabled": bool(config.get("manualEnabled", True)),
        "scheduleEnabled": bool(config.get("scheduleEnabled", False)),
        "scheduleStart": str(config.get("scheduleStart", "09:00")),
        "scheduleEnd": str(config.get("scheduleEnd", "17:00")),
        "scheduleWindows": schedule_windows(config),
        "scheduleOverrideActive": override,
        "scheduleOverrideUntil": str(config.get("scheduleOverrideUntil", "")) if override is not None else "",
        "permanentEnabled": bool(config.get("adultBlockingEnabled", True)),
        "permanentCount": cached_count(
            config,
            "adultCount",
            lambda: len(without_allowlisted(read_domains(ADULT_FILE), read_domains(ALLOWLIST_FILE))),
        ),
        "distractionCount": cached_count(config, "distractionCount", lambda: len(effective_distraction_domains())),
        "curatedCount": cached_count(config, "curatedCount", lambda: len(read_domains(SITES_FILE))),
        "aiAllowCount": cached_count(config, "aiAllowCount", lambda: len(read_domains(ALLOWLIST_FILE))),
        "focusAllowCount": cached_count(
            config, "focusAllowCount", lambda: len(read_domains(FOCUS_ALLOWLIST_FILE))
        ),
        "whitelistCount": cached_count(config, "whitelistCount", lambda: len(read_domains(USER_ALLOWLIST_FILE))),
        "whitelistSites": read_domains(USER_ALLOWLIST_FILE),
        "categoryCounts": {
            category: int(category_counts.get(category, 0)) for category in BLOCK_CATEGORY_ORDER
        },
        "adultUpdated": str(config.get("adultUpdated", "")),
        "listsUpdated": str(config.get("listsUpdated", config.get("adultUpdated", ""))),
        "reason": reason,
    }


def set_manual(enabled: bool, password: str | None = None) -> None:
    config = read_json(CONFIG_FILE)
    if not enabled:
        if password is None:
            fail("Clarity password is required")
        verify_password(password)
    if bool(config.get("scheduleEnabled", False)):
        # The primary toggle is always allowed to override the schedule, but
        # only temporarily. After 24 hours the configured schedule becomes the
        # source of truth again.
        config["scheduleOverrideActive"] = enabled
        config["scheduleOverrideUntil"] = (
            dt.datetime.now().astimezone() + dt.timedelta(seconds=SCHEDULE_OVERRIDE_SECONDS)
        ).isoformat(timespec="seconds")
    else:
        config["manualEnabled"] = enabled
        config.pop("scheduleOverrideActive", None)
        config.pop("scheduleOverrideUntil", None)
    write_json(CONFIG_FILE, config)
    apply_hosts()


def set_schedule(enabled: bool, start: str, end: str, password: str) -> None:
    """Backward-compatible single-window schedule setter."""
    verify_password(password)
    parse_time(start)
    parse_time(end)
    config = read_json(CONFIG_FILE)
    config["scheduleEnabled"] = enabled
    config.pop("scheduleOverrideActive", None)
    config.pop("scheduleOverrideUntil", None)
    config["scheduleStart"] = start
    config["scheduleEnd"] = end
    config["scheduleWindows"] = [{"start": start, "end": end}]
    config["scheduleConfigured"] = True
    write_json(CONFIG_FILE, config)
    apply_hosts()


def set_schedule_enabled(enabled: bool, password: str) -> None:
    verify_password(password)
    config = read_json(CONFIG_FILE)
    if enabled and not schedule_windows(config):
        fail("add at least one schedule window before enabling the schedule")
    config["scheduleEnabled"] = enabled
    config.pop("scheduleOverrideActive", None)
    config.pop("scheduleOverrideUntil", None)
    write_json(CONFIG_FILE, config)
    apply_hosts()


def add_schedule_window(start: str, end: str, password: str) -> int:
    verify_password(password)
    parse_time(start)
    parse_time(end)
    config = read_json(CONFIG_FILE)
    windows = schedule_windows(config)
    was_empty = not windows
    window = {"start": start, "end": end}
    if any(windows_overlap(window, existing) for existing in windows):
        fail("schedule windows may not overlap")
    if len(windows) >= 3:
        fail("Clarity supports up to three schedule windows")
    windows.append(window)
    config["scheduleWindows"] = windows
    config["scheduleStart"] = windows[0]["start"]
    config["scheduleEnd"] = windows[0]["end"]
    config["scheduleConfigured"] = True
    if was_empty:
        config["scheduleEnabled"] = True
    write_json(CONFIG_FILE, config)
    apply_hosts()
    return windows.index(window)


def edit_schedule_window(index: int, start: str, end: str, password: str) -> None:
    verify_password(password)
    parse_time(start)
    parse_time(end)
    config = read_json(CONFIG_FILE)
    windows = schedule_windows(config)
    if index < 0 or index >= len(windows):
        fail("schedule window does not exist")
    replacement = {"start": start, "end": end}
    if any(windows_overlap(replacement, existing) for slot, existing in enumerate(windows) if slot != index):
        fail("schedule windows may not overlap")
    windows[index] = replacement
    config["scheduleWindows"] = windows
    config["scheduleStart"] = windows[0]["start"]
    config["scheduleEnd"] = windows[0]["end"]
    config["scheduleConfigured"] = True
    write_json(CONFIG_FILE, config)
    apply_hosts()


def remove_schedule_window(index: int, password: str) -> None:
    verify_password(password)
    config = read_json(CONFIG_FILE)
    windows = schedule_windows(config)
    if index < 0 or index >= len(windows):
        fail("schedule window does not exist")
    windows.pop(index)
    config["scheduleWindows"] = windows
    config["scheduleConfigured"] = True
    if windows:
        config["scheduleStart"] = windows[0]["start"]
        config["scheduleEnd"] = windows[0]["end"]
    else:
        config["scheduleEnabled"] = False
    write_json(CONFIG_FILE, config)
    apply_hosts()


def update_focus_count_cache() -> None:
    config = read_json(CONFIG_FILE)
    config["distractionCount"] = len(effective_distraction_domains())
    config["whitelistCount"] = len(read_domains(USER_ALLOWLIST_FILE))
    write_json(CONFIG_FILE, config)


def set_whitelist(password: str, content: str) -> int:
    verify_password(password)
    domains = parse_domain_lines(content, max_domains=MAX_WHITELIST_DOMAINS)
    atomic_write(USER_ALLOWLIST_FILE, ("\n".join(domains) + "\n") if domains else "", 0o644)
    update_focus_count_cache()
    apply_hosts()
    return len(domains)


def add_whitelist_site(password: str, value: str) -> tuple[str, int]:
    verify_password(password)
    domains = parse_domain_lines(value)
    if len(domains) != 1:
        fail("enter one valid website URL or domain")
    domain = domains[0]
    combined = sorted(set(read_domains(USER_ALLOWLIST_FILE)) | {domain})
    atomic_write(USER_ALLOWLIST_FILE, "\n".join(combined) + "\n", 0o644)
    update_focus_count_cache()
    apply_hosts()
    return domain, len(combined)


def remove_whitelist_site(password: str, value: str) -> tuple[str, int]:
    verify_password(password)
    domains = parse_domain_lines(value)
    if len(domains) != 1:
        fail("select one valid whitelisted domain")
    domain = domains[0]
    current = set(read_domains(USER_ALLOWLIST_FILE))
    if domain not in current:
        fail(f"{domain} is not in the focus whitelist")
    current.remove(domain)
    remaining = sorted(current)
    atomic_write(USER_ALLOWLIST_FILE, ("\n".join(remaining) + "\n") if remaining else "", 0o644)
    update_focus_count_cache()
    apply_hosts()
    return domain, len(remaining)


def restore_file(backup: Path, target: Path, mode: int, uid: int, gid: int) -> None:
    if not backup.is_file():
        fail(f"required backup is missing: {backup}")
    target.parent.mkdir(parents=True, exist_ok=True)
    fd, tmp_name = tempfile.mkstemp(prefix=f".{target.name}.restore.", dir=target.parent)
    os.close(fd)
    tmp = Path(tmp_name)
    try:
        shutil.copy2(backup, tmp)
        os.chmod(tmp, mode)
        if not TEST_ROOT:
            os.chown(tmp, uid, gid)
        os.replace(tmp, target)
    finally:
        tmp.unlink(missing_ok=True)


def restore_system_backups() -> None:
    if not BACKUP_MANIFEST.exists():
        # Backward compatibility for installations created before manifests.
        if BACKUP_FILE.exists():
            backup_stat = BACKUP_FILE.stat()
            restore_file(
                BACKUP_FILE,
                HOSTS_FILE,
                stat.S_IMODE(backup_stat.st_mode),
                backup_stat.st_uid,
                backup_stat.st_gid,
            )
        else:
            remove_managed_hosts()
        for target in system_backup_targets()[1:]:
            target.unlink(missing_ok=True)
        return

    manifest = read_json(BACKUP_MANIFEST)
    entries = manifest.get("files")
    if manifest.get("version") != 1 or not isinstance(entries, dict):
        fail("invalid Clarity backup manifest")

    allowed_backups = {BACKUP_FILE.resolve()}
    if BACKUP_DIR.exists():
        allowed_backups.update(path.resolve() for path in BACKUP_DIR.iterdir() if path.is_file())
    for target in system_backup_targets():
        entry = entries.get(str(target))
        if not isinstance(entry, dict) or not isinstance(entry.get("existed"), bool):
            fail(f"backup manifest is missing {target}")
        if entry["existed"]:
            backup = Path(str(entry.get("backup", "")))
            if backup.resolve() not in allowed_backups:
                fail(f"unsafe backup path for {target}")
            restore_file(
                backup,
                target,
                int(entry.get("mode", 0o644)),
                int(entry.get("uid", 0)),
                int(entry.get("gid", 0)),
            )
        else:
            target.unlink(missing_ok=True)


def remove_managed_hosts() -> None:
    if not HOSTS_FILE.exists():
        return
    original = HOSTS_FILE.read_text(encoding="utf-8")
    content = strip_managed_sections(original)
    content = content + "\n" if content else ""
    if content == original:
        return
    previous_stat = HOSTS_FILE.stat()
    atomic_write(HOSTS_FILE, content, stat.S_IMODE(previous_stat.st_mode))
    if not TEST_ROOT:
        os.chown(HOSTS_FILE, previous_stat.st_uid, previous_stat.st_gid)
    flush_dns()


def uninstall() -> None:
    run_systemctl("disable", "--now", "clarity-reconcile.timer", "clarity-adult-list.timer", check=False)
    restore_system_backups()
    run_systemctl("daemon-reload", check=False)
    flush_dns()
    shutil.rmtree(STATE_DIR, ignore_errors=True)
    print("Clarity system files restored; setup state removed.")


def usage() -> str:
    return """Usage: clarity-root COMMAND [ARGS]

Commands:
  bootstrap PLUGIN_DIR OWNER ADULT_STATE
                                  Install; adult state is enabled or disabled
  upgrade PLUGIN_DIR              Upgrade feeds/config while preserving state
  status                          Print JSON state
  enable                          Enable distraction blocking
  disable                         Disable blocking; password on stdin
  schedule-set STATE START END    Set one window (backward compatible)
  schedule-state STATE            Enable/disable windows; password on stdin
  schedule-window-add START END   Add a daily window; password on stdin
  schedule-window-edit INDEX START END
                                  Edit a window; password on stdin
  schedule-window-remove INDEX    Remove a window; password on stdin
  whitelist-list                  Print focus whitelist domains
  whitelist-set                   Replace whitelist; password first on stdin
  whitelist-add SITE              Add one URL/domain; password on stdin
  whitelist-remove SITE           Remove one domain; password on stdin
  reconcile                       Apply current/scheduled state
  update-lists                    Refresh permanent and focus blocklists
  update-adult                    Backward-compatible alias for update-lists
  enable-adult                    Permanently enable adult blocking until uninstall
  uninstall                       Remove all Clarity system integration
"""


def main(argv: list[str]) -> int:
    require_root()
    if not argv or argv[0] in {"-h", "--help", "help"}:
        print(usage(), end="")
        return 0
    command, *args = argv
    if command == "bootstrap" and len(args) == 3:
        bootstrap(args[0], args[1], args[2])
    elif command == "upgrade" and len(args) == 1:
        upgrade(args[0])
    elif command == "status" and not args:
        print(json.dumps(status(), separators=(",", ":")))
    elif command == "enable" and not args:
        set_manual(True)
        print("Clarity is on.")
    elif command == "disable" and not args:
        set_manual(False, read_password_from_stdin())
        print(" Success. Clarity Blocker is off.")
    elif command == "schedule-set" and len(args) == 3 and args[0] in {"enabled", "disabled"}:
        set_schedule(args[0] == "enabled", args[1], args[2], read_password_from_stdin())
        print(f"Schedule {args[0]} ({args[1]}–{args[2]}).")
    elif command == "schedule-state" and len(args) == 1 and args[0] in {"enabled", "disabled"}:
        set_schedule_enabled(args[0] == "enabled", read_password_from_stdin())
        print(f"Schedule {args[0]}.")
    elif command == "schedule-window-add" and len(args) == 2:
        index = add_schedule_window(args[0], args[1], read_password_from_stdin())
        print(f"Added schedule window {index + 1} ({args[0]}–{args[1]}).")
    elif command == "schedule-window-edit" and len(args) == 3 and args[0].isdigit():
        edit_schedule_window(int(args[0]), args[1], args[2], read_password_from_stdin())
        print(f"Updated schedule window ({args[1]}–{args[2]}).")
    elif command == "schedule-window-remove" and len(args) == 1 and args[0].isdigit():
        remove_schedule_window(int(args[0]), read_password_from_stdin())
        print("Removed schedule window.")
    elif command == "whitelist-list" and not args:
        print(USER_ALLOWLIST_FILE.read_text(encoding="utf-8"), end="")
    elif command == "whitelist-set" and not args:
        password = read_password_from_stdin()
        count = set_whitelist(password, read_whitelist_from_stdin())
        print(f"Saved {count} whitelisted domains for focus blocking.")
    elif command == "whitelist-add" and len(args) == 1:
        domain, count = add_whitelist_site(read_password_from_stdin(), args[0])
        print(f"Whitelisted {domain} for focus blocking ({count} total).")
    elif command == "whitelist-remove" and len(args) == 1:
        domain, count = remove_whitelist_site(read_password_from_stdin(), args[0])
        print(f"Removed {domain} from the focus whitelist ({count} remaining).")
    elif command == "reconcile" and not args:
        changed = apply_hosts()
        print("Clarity hosts updated." if changed else "Clarity hosts already current.")
    elif command in {"update-lists", "update-adult"} and not args:
        adult_count, focus_count = update_lists()
        print(f"Updated blocklists ({adult_count} permanent, {focus_count} focus-feed domains).")
    elif command == "enable-adult" and not args:
        adult_count = enable_permanent_adult_blocking()
        print(f"Persistent adult blocking enabled ({adult_count} domains).")
    elif command == "uninstall" and not args:
        uninstall()
    else:
        fail("invalid command or arguments\n" + usage().rstrip())
    return 0


if __name__ == "__main__":
    try:
        raise SystemExit(main(sys.argv[1:]))
    except ClarityError as error:
        print(f"clarity: {error}", file=sys.stderr)
        raise SystemExit(1)
    except KeyboardInterrupt:
        print("clarity: cancelled", file=sys.stderr)
        raise SystemExit(130)
